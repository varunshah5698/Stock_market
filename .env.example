# ---- StockPulse AI configuration (copy to .env, never commit .env) ----

# development | production
APP_ENV=development

# Public URL of the SPA (used for links + CORS)
APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# Comma-separated SPA origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:5173

# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-only

# PostgreSQL recommended for production, e.g.
# postgresql+psycopg://user:pass@host/db?sslmode=require
# SQLite is used for local development only.
DATABASE_URL=sqlite:///./stockpulse.db
# Used only by docker-compose.yml; never used by the app directly.
POSTGRES_PASSWORD=change-me-local-db-password

# Create tables at startup. Set false in production and run: alembic upgrade head
AUTO_CREATE_SCHEMA=true

# Background scheduler (alerts + resting paper limit evaluation).
BACKGROUND_JOBS=true

# Session cookie security. Set true (and serve over HTTPS) in production.
COOKIE_SECURE=false
SESSION_DAYS=7

# Market data: "yahoo" (real data via yfinance, delayed) or "sample"
# (deterministic simulated data, clearly labelled, for offline demos/tests).
MARKET_DATA_PROVIDER=yahoo
DATA_CACHE_MINUTES=20

# Max upload size for Data Studio CSV imports
MAX_UPLOAD_MB=8

# Optional integrations. Leave blank to keep the feature in a documented
# "not configured" state. The app will never fabricate data for these.
NEWS_API_KEY=
BROKER_ADAPTER=
BROKER_API_KEY=
BROKER_API_SECRET=

# Paper trading defaults
PAPER_STARTING_CASH=100000
PAPER_COMMISSION_BPS=2
PAPER_SLIPPAGE_BPS=5
